function Actions takes nothing returns nothing
local location array xp
local real xr
local real xr1
local real xr2
local integer xa
local integer xb
local unit xu=GetTriggerUnit()
local player pl=GetOwningPlayer(xu)
set xp[0]=GetUnitLoc(xu)
set xp[17]=GetSpellTargetLoc()
set xr=(AngleBetweenPoints(xp[0],xp[17])-95.00)
call RemoveLocation(xp[0])
set xp[0]=xp[17]
set xp[1]=PolarProjectionBJ(xp[0],241.96,(-47.89+xr))
set xp[2]=PolarProjectionBJ(xp[0],258.87,(-66.01+xr))
set xp[3]=PolarProjectionBJ(xp[0],263.73,(-82.54+xr))
set xp[4]=PolarProjectionBJ(xp[0],238.72,(-111.24+xr))
set xp[5]=PolarProjectionBJ(xp[0],219.18,(-139.53+xr))
set xp[6]=PolarProjectionBJ(xp[0],220.88,(-170.75+xr))
set xp[7]=PolarProjectionBJ(xp[0],237.01,(159.50+xr))
set xp[8]=PolarProjectionBJ(xp[0],432.59,(159.71+xr))
set xp[9]=PolarProjectionBJ(xp[0],257.35,(133.15+xr))
set xp[10]=PolarProjectionBJ(xp[0],639.01,(117.27+xr))
set xp[11]=PolarProjectionBJ(xp[0],238.57,(104.94+xr))
set xp[12]=PolarProjectionBJ(xp[0],775.44,(102.34+xr))
set xp[13]=PolarProjectionBJ(xp[0],208.18,(67.62+xr))
set xp[14]=PolarProjectionBJ(xp[0],687.95,(87.44+xr))
set xp[15]=PolarProjectionBJ(xp[0],208.61,(-29.12+xr))
set xp[16]=PolarProjectionBJ(xp[0],521.16,(65.24+xr))
call UnitAddAbilityBJ('Aloc',xu)
call UnitAddAbilityBJ('Amrf',xu)
call UnitRemoveAbilityBJ('Amrf',xu)
call SetCameraFieldForPlayer(pl,CAMERA_FIELD_TARGET_DISTANCE,4000.00,1.00)
call SetUnitFlyHeight(xu,1000.00,4000.00)
call PolledWait(0.80)
call SetUnitPositionLoc(xu,xp[17])
call SetUnitFlyHeight(xu,0.00,4000.00)
set xa=1
set xb=6
loop
exitwhen xa>xb
set xp[18]=PolarProjectionBJ(xp[0],110.00,(60.00*I2R(xa)))
call CreateNUnitsAtLoc(1,'nhef',pl,xp[18],0)
set xa=xa+1
call RemoveLocation(xp[18])
endloop
set xa=0
set xb=16
loop
exitwhen xa>xb
call CreateNUnitsAtLoc(1,'nhef',pl,xp[xa],0)
set xa=xa+1
endloop
set xa=1
set xb=3
loop
exitwhen xa>xb
set xr1=DistanceBetweenPoints(xp[9],xp[10])*(I2R(xa)/4.00)
set xr2=AngleBetweenPoints(xp[9],xp[10])
set xp[18]=PolarProjectionBJ(xp[9],xr1,xr2)
call CreateNUnitsAtLoc(1,'nhef',pl,xp[18],0)
call RemoveLocation(xp[18])
set xr1=DistanceBetweenPoints(xp[13],xp[14])*(I2R(xa)/4.00)
set xr2=AngleBetweenPoints(xp[13],xp[14])
set xp[18]=PolarProjectionBJ(xp[13],xr1,xr2)
call CreateNUnitsAtLoc(1,'nhef',pl,xp[18],0)
call RemoveLocation(xp[18])
set xa=xa+1
endloop
set xa=1
set xb=4
loop
exitwhen xa>xb
set xr1=DistanceBetweenPoints(xp[11],xp[12])*(I2R(xa)/5.00)
set xr2=AngleBetweenPoints(xp[11],xp[12])
set xp[18]=PolarProjectionBJ(xp[11],xr1,xr2)
call CreateNUnitsAtLoc(1,'nhef',pl,xp[18],0)
call RemoveLocation(xp[18])
set xa=xa+1
endloop
set xa=1
set xb=5
loop
exitwhen xa>xb
set xr1=DistanceBetweenPoints(xp[15],xp[16])*(I2R(xa)/6.00)
set xr2=AngleBetweenPoints(xp[15],xp[16])
set xp[18]=PolarProjectionBJ(xp[15],xr1,xr2)
call CreateNUnitsAtLoc(1,'nhef',pl,xp[18],0)
call RemoveLocation(xp[18])
set xa=xa+1
endloop
set xr1=DistanceBetweenPoints(xp[7],xp[8])/2.00
set xr2=AngleBetweenPoints(xp[7],xp[8])
set xp[18]=PolarProjectionBJ(xp[7],xr1,xr2)
call CreateNUnitsAtLoc(1,'nhef',pl,xp[18],0)
call RemoveLocation(xp[18])
call SetCameraFieldForPlayer(GetOwningPlayer(xu),CAMERA_FIELD_TARGET_DISTANCE,1500.00,1.00)
call UnitRemoveAbilityBJ('Aloc',xu)
call ShowUnitHide(xu)
call ShowUnitShow(xu)
call SelectUnitAddForPlayer(xu,GetOwningPlayer(xu))
set xa=0
set xb=17
loop
exitwhen xa>xb
call RemoveLocation(xp[xa])
set xp[xa]=null
set xa=xa+1
endloop
set xu=null
set xa=0
set xb=0
set xr=0.00
set xr1=0.00
set xr2=0.00
set pl=null
endfunction
