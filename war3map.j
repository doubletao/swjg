function Trig_Bord_Actions takes nothing returns nothing
call CreateMultiboardBJ(4,9,"玩家信息")
call MultiboardDisplayBJ(true,GetLastCreatedMultiboard())
call MultiboardMinimizeBJ(false,GetLastCreatedMultiboard())
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),1,1,"|cffFF870F玩家姓名|r")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),2,1,"|cffFF870F杀怪数|r")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),3,1,"|cffFF870F斩将数|r")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),4,1,"|cffFF870F官阶等级|r")
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=9
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set udg_SSSZ=GetForLoopIndexA()
