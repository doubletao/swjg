if(not(GetUnitUserData(GetTriggerUnit())==1))then
return false
endif
return true
endfunction
function Trig_XZFJ_Actions takes nothing returns nothing
if(Trig_XZFJ_Func010C())then
call SetUnitOwner(GetTriggerUnit(),GetTriggerPlayer(),true)
call SetUnitInvulnerable(GetTriggerUnit(),false)
call SetUnitPositionLoc(GetTriggerUnit(),GetRectCenter(gg_rct_kai_shi))
call SetHeroLevel(GetTriggerUnit(),GetUnitLevel(udg_YINGXIONG[GetConvertedPlayerId(GetTriggerPlayer())]),true)
call PanCameraToTimedLocForPlayer(GetTriggerPlayer(),GetUnitLoc(gg_unit_Hant_0005),0)
else
endif
call SetUnitUserData(GetTriggerUnit(),1)
call TriggerSleepAction(0.30)
call SetUnitUserData(GetTriggerUnit(),3)
endfunction
