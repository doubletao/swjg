endif
return true
endfunction
function Trig_PK_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
set udg_TYSJY[11]=null
set udg_TYSJY[12]=null
call DialogSetMessage(udg_dhk,(GetPlayerName(GetOwningPlayer(GetTriggerUnit()))+"向你挑战,是否应战?"))
call DialogAddButtonBJ(udg_dhk,"|cff80FFFF接受挑战")
set udg_PKOK=GetLastCreatedButtonBJ()
call DialogAddButtonBJ(udg_dhk,"|Cff00ff00无视对方")
set udg_PKNO=GetLastCreatedButtonBJ()
call DialogDisplayBJ(true,udg_dhk,GetOwningPlayer(GetSpellTargetUnit()))
call DisplayTextToForce(GetPlayersAll(),(GetUnitName(GetTriggerUnit())+("对"+(GetUnitName(GetSpellTargetUnit())+"邀请PK"))))
set udg_TYSJY[11]=GetTriggerUnit()
set udg_TYSJY[12]=GetSpellTargetUnit()
call EnableTrigger(gg_trg_PKDH)
call TriggerSleepAction(120.00)
call EnableTrigger(GetTriggeringTrigger())
endfunction
