function Trig_NDXZ_Func002A takes nothing returns nothing
call AdjustPlayerStateBJ(500,GetEnumPlayer(),PLAYER_STATE_RESOURCE_GOLD)
endfunction
function Trig_NDXZ_Func003A takes nothing returns nothing
call TriggerRegisterUnitEvent(gg_trg_SH,GetEnumUnit(),EVENT_UNIT_DAMAGED)
call ShowUnitHide(GetEnumUnit())
endfunction
function Trig_NDXZ_Func018001001 takes nothing returns boolean
return(GetPlayerSlotState(Player(0))==PLAYER_SLOT_STATE_PLAYING)
endfunction
function Trig_NDXZ_Func018001002 takes nothing returns boolean
return(GetPlayerController(Player(0))==MAP_CONTROL_USER)
endfunction
function Trig_NDXZ_Func018001 takes nothing returns boolean
return GetBooleanAnd(Trig_NDXZ_Func018001001(),Trig_NDXZ_Func018001002())
endfunction
function Trig_NDXZ_Actions takes nothing returns nothing
call SetUnitVertexColorBJ(gg_unit_Ucrl_0143,100,100,100,45.00)
call ForForce(GetPlayersAll(),function Trig_NDXZ_Func002A)
call ForGroupBJ(GetUnitsInRectAll(gg_rct________0451),function Trig_NDXZ_Func003A)
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"游戏介绍","|cff0080FF欢迎访问专区：http://tstd.uuu9.com\n三国后期，魏国大举进攻蜀国；剑阁是蜀国最后的屏障，一旦失守，蜀国就将灭亡！你需要成功防守敌人的26波进攻，并且战胜最后的BOSS，才能获得胜利。每一波怪到最后都会出现一个敌方的主将（BOSS），需要消灭主将才能进行下一波。","ReplaceableTextures\\CommandButtons\\BTNNecromancerMaster.blp")
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"游戏群","|cff0080FF五虎将游戏群：31473994（一群）74050116（二群）","ReplaceableTextures\\CommandButtons\\BTNNecromancerMaster.blp")
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"五行生克","|cff0080FF游戏中，掌握五行生克关系非常重要！\n五行相生之规律:木生火,火生土,土生金,金生水,水生木。\n五行相克之规律:木克土,土克水,水克火,火克金,金克木。\n金系:在生克方面表现不突出，适应性强，没有突出的优点。\n木系:拥有不错的速度，防御能力较弱，害怕金系攻击。\n水系:拥有不错的恢复能力，物理攻击能力差，害怕土系攻击	火系:拥有不错的攻击力，特别害怕水系攻击	\n土系:拥有不错的防御力，速度较慢，害怕木系攻击","war3mapImported\\wx5.BLP")
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"专署介绍","姜维：可用除斧外所有武器\n马岱，赵统，关凤：可用除斧外所有近战武器\n赵广：可用弓类武器\n祝融夫人：可用弓类武器，部分近战武器\n马谡，陆逊，黄月英，蒋琬：可用扇，杖类武器\n木鹿大王：可用弓类，斧类武器\n夏侯霸，刘谌，廖化，王平，张苞，孟获，关索，关兴：可用所有近战武器\n特别注释：\n剑类武器以及日月乾坤轮，七星宝刀为通用武器。\n玄武战甲，刑天盾：力量型英雄，及关兴才可使用\n青龙偃月刀：关家专署武器\n丈八蛇矛：张苞专署武器\n","ReplaceableTextures\\CommandButtons\\BTNNecromancerMaster.blp")
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"历史","TRIGSTR_8409","ReplaceableTextures\\CommandButtons\\BTNSpellBookBLS.blp")
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"上古十神器","TRIGSTR_8557","ReplaceableTextures\\CommandButtons\\BTNSpellBookBLS.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"奋勇杀敌！","郭淮死后，任务才出现。玩家中最先杀死1000个敌人（敌将算10个），会获得30属性+3万金钱奖励。","ReplaceableTextures\\CommandButtons\\BTNAmbush.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"假传圣旨！","张辽波以后，任务出现。因为天气的原因，大雨骤降，栈道断绝，蜀国的粮草供应不及。李严假传圣旨召孔明回师。","ReplaceableTextures\\CommandButtons\\BTNAmbush.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"修真","击杀圣兽以后，会得到兽魂。再到复活点找大男人（牛神）完成任务。修真技能伤害跟使用次数有关，需要经常使用才能提升。","ReplaceableTextures\\CommandButtons\\BTNAmbush.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"五虎将","杀死BOOS后会爆虎符，拿虎符走到孔明就能得到五虎官职(跟交玉玺一样)。徐晃必爆。（五虎将特点：增加一被动回复技能，增加50%生命、魔法、攻击和移动速度）切记不可以在得到五虎将技能时再去找孔明，否则后果自负。","ReplaceableTextures\\CommandButtons\\BTNAmbush.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"孔明清包","需难度四以上,任意玩家输入QB,可清孔明身上装备。","ReplaceableTextures\\CommandButtons\\BTNAmbush.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"游戏命令","红色玩家输入:-Q  即可清除地上物品,慎用!!!\n红色玩家输入:-TR+玩家编号  即可踢除玩家,慎用!!!\n任意玩家输入:-JHYX+玩家编号  即可与对方交换英雄","ReplaceableTextures\\CommandButtons\\BTNAmbush.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"新增佣兵","*增加诸葛弩,攻击强劲,射程远,能够搭乘单位,当搭乘南蛮苦工操作时,将会提升战斗能力.(诸葛瞻及黄月英搭乘战斗力提升的更多)\n|n*增加弓骑兵,需要开启新城（必须保住孟达不死）,在新城军需官处购买马匹,安全带回剑阁,再买弓箭手搭乘,即可变成弓骑兵","ReplaceableTextures\\CommandButtons\\BTNAmbush.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"难度一作弊模式","[难度一]任意玩家输入：我要作弊  即可开启作弊模式\n|n输入：我要钱   增加100000金钱\n|n输入：我要木   增加1000木头\n|n输入：一个英雄不够用   开启多英雄选择模式（游戏开始120秒后无作用）","ReplaceableTextures\\CommandButtons\\BTNAmbush.blp")
if(Trig_NDXZ_Func018001())then
call PauseAllUnitsBJ(true)
else
return
endif
call DisplayTimedTextToForce(GetPlayersAll(),5.00,"|Cff00ff00正在选择游戏模式，请稍等。|r")
call DialogSetMessage(udg_dhk,"请选择游戏难度: \n")
call DialogAddButtonBJ(udg_dhk,"|cff80FFFF无名小卒（轻松）")
set udg_DHAN=GetLastCreatedButtonBJ()
call DialogAddButtonBJ(udg_dhk,"|Cff00ff00英雄初上阵（普通）")
set udg_DHAN2=GetLastCreatedButtonBJ()
call DialogAddButtonBJ(udg_dhk,"|cffffdead鼎足三分（规则）")
set udg_DHAN3=GetLastCreatedButtonBJ()
call DialogAddButtonBJ(udg_dhk,"|Cffff0000纵横天下（极难）")
set udg_DHAN4=GetLastCreatedButtonBJ()
call DialogAddButtonBJ(udg_dhk,"|Cffff0000逆天行事（你有那个能力吗?）")
set udg_DHAN5=GetLastCreatedButtonBJ()
call DialogDisplayBJ(true,udg_dhk,Player(0))
call TriggerExecute(gg_trg_JLJLJL)
call TriggerExecute(gg_trg_YXJHDHK)
endfunction
