function Trig_DALIE_Actions takes nothing returns nothing
if(Trig_DALIE_Func002C())then
call AdjustPlayerStateBJ((GetItemCharges(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'pomn'))*3000),GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'pomn'))
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nhew_0081,"猎人",null,"这些兽皮还不错！",bj_TIMETYPE_ADD,0,true)
else
if(Trig_DALIE_Func002Func001C())then
call AdjustPlayerStateBJ((GetItemCharges(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'srrc'))*8000),GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)
call UnitAddItemByIdSwapped('pclr',GetTriggerUnit())
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'srrc'))
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nhew_0081,"猎人",null,"你带回来的兽皮太棒了！看你一定是个打猎的好手,有个好东西卖给你",bj_TIMETYPE_ADD,0,true)
call DisableTrigger(GetTriggeringTrigger())
call EnableTrigger(gg_trg_DALIE_______u)
else
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nhew_0081,"猎人",null,"你可以帮我找些兽皮回来吗？我愿意高价收购！",bj_TIMETYPE_ADD,0,true)
endif
endif
endfunction
