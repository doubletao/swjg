call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nmed_0096,"村长",null,"对岸的森林里有一群强盗经常到村里来抢掠财物，村民们都去了别的村落避难，如果你能将他们杀死，我会好好酬谢你的。",bj_TIMETYPE_ADD,0,true)
call DisplayTextToForce(GetPlayersAll(),"杀死强盗头子，并将其首级带回来给村长。")
