endif
return true
endfunction
function Trig_DIRWANG_Actions takes nothing returns nothing
call DestroyTrigger(GetTriggeringTrigger())
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nskk_0126,"dir_wang",null,"你好，欢迎来到剑阁-五虎将后传中游戏！我是该地图的原作者逍遥。\n很不幸，由于受到司马懿的法术影响，我变成魂状态...所以想请你帮个忙，帮我们找到一些“纯净水”，我就能恢复到正常的样子了！",bj_TIMETYPE_ADD,0,true)
call EnableTrigger(gg_trg_dirwang)
endfunction
function InitTrig_DIRWANG takes nothing returns nothing
set gg_trg_DIRWANG=CreateTrigger()
call TriggerRegisterEnterRectSimple(gg_trg_DIRWANG,gg_rct______________063)
call TriggerAddCondition(gg_trg_DIRWANG,Condition(function Trig_DIRWANG_Conditions))
call TriggerAddAction(gg_trg_DIRWANG,function Trig_DIRWANG_Actions)
endfunction
function Trig_dirwang_Conditions takes nothing returns boolean
if(not(GetSpellAbilityId()=='AIps'))then
return false
endif
return true
endfunction
function Trig_dirwang_Func001C takes nothing returns boolean
if(not(GetSpellTargetUnit()==gg_unit_nskk_0126))then
return false
endif
return true
endfunction
function Trig_dirwang_Actions takes nothing returns nothing
if(Trig_dirwang_Func001C())then
call UnitRemoveAbilityBJ('Apiv',GetSpellTargetUnit())
call DisplayTimedTextToForce(GetPlayersAll(),5.00,(GetUnitName(GetSpellTargetUnit())+"已经被拯救，所有属性+5！"))
call ModifyHeroStat(bj_HEROSTAT_STR,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,5)
call ModifyHeroStat(bj_HEROSTAT_AGI,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,5)
call ModifyHeroStat(bj_HEROSTAT_INT,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,5)
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nskk_0126,"逍遥",null,"听说有本禁书叫<三国演义>,你能帮我搞一本来吗?",bj_TIMETYPE_ADD,0,false)
call EnableTrigger(gg_trg_HQZS)
call DestroyTrigger(GetTriggeringTrigger())
else
endif
endfunction
function InitTrig_dirwang takes nothing returns nothing
set gg_trg_dirwang=CreateTrigger()
call DisableTrigger(gg_trg_dirwang)
call TriggerRegisterAnyUnitEventBJ(gg_trg_dirwang,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_dirwang,Condition(function Trig_dirwang_Conditions))
call TriggerAddAction(gg_trg_dirwang,function Trig_dirwang_Actions)
endfunction
