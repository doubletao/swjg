if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"法正：法正能预见未来的成败得失，与程昱、郭嘉是同等人物。\n可学得：汲取术，蚀心咒，化魔盾，星落\n|Cff00ff00终极技能：星辰爆")
else
