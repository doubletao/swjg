function Trig_QYJ_KS_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call PauseUnit(udg_TYSJY[0],true)
call PauseUnit(udg_TYSJY[1],true)
call PauseUnit(udg_TYSJY[2],true)
call SetUnitInvulnerable(udg_TYSJY[0],true)
call SetUnitInvulnerable(udg_TYSJY[1],true)
call SetUnitInvulnerable(udg_TYSJY[2],true)
set udg_QYD[3]=PolarProjectionBJ(udg_QYMBD,500.00,0)
set udg_QYD[4]=PolarProjectionBJ(udg_QYMBD,500.00,120.00)
set udg_QYD[5]=PolarProjectionBJ(udg_QYMBD,500.00,240.00)
call UnitAddAbility(udg_TYSJY[0],'Amrf')
call UnitAddAbility(udg_TYSJY[1],'Amrf')
call UnitAddAbility(udg_TYSJY[2],'Amrf')
call UnitRemoveAbility(udg_TYSJY[0],'Amrf')
call UnitRemoveAbility(udg_TYSJY[1],'Amrf')
call UnitRemoveAbility(udg_TYSJY[2],'Amrf')
call SetUnitX(udg_TYSJY[0],GetLocationX(udg_QYD[3]))
call SetUnitY(udg_TYSJY[0],GetLocationY(udg_QYD[3]))
call SetUnitFlyHeight(udg_TYSJY[0],500.00,1000.00)
call SetUnitX(udg_TYSJY[1],GetLocationX(udg_QYD[4]))
call SetUnitY(udg_TYSJY[1],GetLocationY(udg_QYD[4]))
call SetUnitFlyHeight(udg_TYSJY[1],500.00,1000.00)
call SetUnitX(udg_TYSJY[2],GetLocationX(udg_QYD[5]))
call SetUnitY(udg_TYSJY[2],GetLocationY(udg_QYD[5]))
call SetUnitFlyHeight(udg_TYSJY[2],500.00,1000.00)
call EnableTrigger(gg_trg_QYJ1)
call AddLightningLoc("CLPB",udg_QYD[3],udg_QYD[4])
call SetLightningColor(GetLastCreatedLightningBJ(),GetRandomReal(0.00,1),GetRandomReal(0,1),GetRandomReal(0,1),1)
set udg_SDXL[0]=bj_lastCreatedLightning
call AddLightningLoc("CLPB",udg_QYD[3],udg_QYD[5])
call SetLightningColor(GetLastCreatedLightningBJ(),GetRandomReal(0.00,1),GetRandomReal(0,1),GetRandomReal(0,1),1)
set udg_SDXL[1]=bj_lastCreatedLightning
call AddLightningLoc("CLPB",udg_QYD[4],udg_QYD[5])
call SetLightningColor(GetLastCreatedLightningBJ(),GetRandomReal(0.00,1),GetRandomReal(0,1),GetRandomReal(0,1),1)
set udg_SDXL[2]=bj_lastCreatedLightning
call AddLightningLoc("AFOD",udg_QYD[3],udg_QYMBD)
call SetLightningColor(GetLastCreatedLightningBJ(),GetRandomReal(0.00,1),GetRandomReal(0,1),GetRandomReal(0,1),1)
set udg_SDXL[3]=bj_lastCreatedLightning
call AddLightningLoc("AFOD",udg_QYD[4],udg_QYMBD)
call SetLightningColor(GetLastCreatedLightningBJ(),GetRandomReal(0.00,1),GetRandomReal(0,1),GetRandomReal(0,1),1)
set udg_SDXL[4]=bj_lastCreatedLightning
call AddLightningLoc("AFOD",udg_QYD[5],udg_QYMBD)
call SetLightningColor(GetLastCreatedLightningBJ(),GetRandomReal(0.00,1),GetRandomReal(0,1),GetRandomReal(0,1),1)
set udg_SDXL[5]=bj_lastCreatedLightning
set udg_QYJZS=1
loop
exitwhen udg_QYJZS>60
set udg_QYD[6]=PolarProjectionBJ(udg_QYMBD,500.00,(I2R(udg_QYJZS)*6.00))
call CreateDestructableLoc('YTfb',udg_QYD[6],GetRandomDirectionDeg(),1,0)
set udg_KPW[udg_QYJZS]=bj_lastCreatedDestructable
call RemoveLocation(udg_QYD[6])
set udg_QYJZS=udg_QYJZS+1
endloop
call TriggerSleepAction(5.00)
call DisableTrigger(gg_trg_QYJ1)
call SetUnitPositionLoc(udg_TYSJY[0],udg_QYMBD)
call SetUnitPositionLoc(udg_TYSJY[1],udg_QYMBD)
call SetUnitPositionLoc(udg_TYSJY[2],udg_QYMBD)
call SetUnitFlyHeight(udg_TYSJY[0],0.00,1000.00)
call SetUnitFlyHeight(udg_TYSJY[1],0.00,1000.00)
call SetUnitFlyHeight(udg_TYSJY[2],0.00,1000.00)
call RemoveLocation(udg_QYMBD)
call RemoveLocation(udg_QYD[3])
call RemoveLocation(udg_QYD[4])
call RemoveLocation(udg_QYD[5])
call DestroyLightning(udg_SDXL[0])
call DestroyLightning(udg_SDXL[1])
call DestroyLightning(udg_SDXL[2])
call DestroyLightning(udg_SDXL[3])
call DestroyLightning(udg_SDXL[4])
call DestroyLightning(udg_SDXL[5])
call PauseUnit(udg_TYSJY[0],false)
call PauseUnit(udg_TYSJY[1],false)
call PauseUnit(udg_TYSJY[2],false)
call SetUnitInvulnerable(udg_TYSJY[0],false)
call SetUnitInvulnerable(udg_TYSJY[1],false)
call SetUnitInvulnerable(udg_TYSJY[2],false)
set udg_QYJZS=1
loop
exitwhen udg_QYJZS>60
call RemoveDestructable(udg_KPW[udg_QYJZS])
set udg_QYJZS=udg_QYJZS+1
endloop
call EnableTrigger(gg_trg_QYJ_KS)
endfunction
