return false
endif
return true
endfunction
function Trig_LONG_JUAN_1_Actions takes nothing returns nothing
if(Trig_LONG_JUAN_1_Func001C())then
set udg_f=(udg_f+1)
set udg_h=((-1.50*Pow(udg_f,2.00))+600.00)
set udg_ljfss=20.00
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=udg_i
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call SetUnitFlyHeight(udg_us[bj_forLoopAIndex],udg_h,0.00)
call SetUnitFacingToFaceUnitTimed(udg_us[bj_forLoopAIndex],udg_hero,0)
set udg_p1x=GetUnitX(udg_us[bj_forLoopAIndex])
set udg_p1y=GetUnitY(udg_us[bj_forLoopAIndex])
if(Trig_LONG_JUAN_1_Func001Func006Func005001())then
call SetUnitAnimation(udg_us[bj_forLoopAIndex],"death")
else
call DoNothing()
endif
if(Trig_LONG_JUAN_1_Func001Func006Func006001())then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",udg_us[bj_forLoopAIndex],"chest"))
else
call DoNothing()
endif
if(Trig_LONG_JUAN_1_Func001Func006Func007C())then
set udg_ang=bj_RADTODEG*Atan2(udg_p0y-udg_p1y,udg_p0x-udg_p1x)-60.00
set udg_p2x=(udg_p1x+(40.00*CosBJ(udg_ang)))
set udg_p2y=(udg_p1y+(40.00*SinBJ(udg_ang)))
else
set udg_ang=bj_RADTODEG*Atan2(udg_p0y-udg_p1y,udg_p0x-udg_p1x)-(130.00+(2.00*udg_f))
set udg_p2x=(udg_p1x+(udg_ljfss*CosBJ(udg_ang)))
set udg_p2y=(udg_p1y+(udg_ljfss*SinBJ(udg_ang)))
endif
call SetUnitPosition(udg_us[bj_forLoopAIndex],udg_p2x,udg_p2y)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
call PauseTimer(udg_t)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=udg_i
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call SetUnitFlyHeight(udg_us[bj_forLoopAIndex],GetUnitDefaultFlyHeight(udg_us[bj_forLoopAIndex]),333.00)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",GetUnitX(udg_us[bj_forLoopAIndex]),GetUnitY(udg_us[bj_forLoopAIndex])))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endfunction
