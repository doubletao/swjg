function Trig_zhunbei_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call GroupClear(udg_TJDWZ)
set udg_TJd1=GetSpellTargetLoc()
set udg_TJzs=0
set udg_TJd2=PolarProjectionBJ(udg_TJd1,200.00,0)
set udg_TJd3=PolarProjectionBJ(udg_TJd1,200.00,180.00)
set udg_TJd4=PolarProjectionBJ(udg_TJd1,200.00,135.00)
set udg_TJd5=PolarProjectionBJ(udg_TJd1,200.00,315.00)
set udg_TJ_ZS=1
loop
exitwhen udg_TJ_ZS>36
set udg_TJzs=(udg_TJzs+10)
set udg_TJYDD[0]=PolarProjectionBJ(udg_TJd1,400.00,I2R(udg_TJzs))
call CreateNUnitsAtLocFacingLocBJ(1,'e00F',GetOwningPlayer(GetTriggerUnit()),udg_TJYDD[0],udg_TJd1)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BHwe',1.50)
call GroupAddUnit(udg_TJdwz,bj_lastCreatedUnit)
set udg_TJYDD[1]=PolarProjectionBJ(udg_TJd4,70.00,I2R(udg_TJzs))
call CreateNUnitsAtLocFacingLocBJ(1,'e00F',GetOwningPlayer(GetTriggerUnit()),udg_TJYDD[1],udg_TJd1)
call RemoveLocation(udg_TJYDD[0])
call UnitApplyTimedLife(bj_lastCreatedUnit,'BHwe',1.50)
call GroupAddUnit(udg_TJdwz,bj_lastCreatedUnit)
call RemoveLocation(udg_TJYDD[1])
set udg_TJYDD[2]=PolarProjectionBJ(udg_TJd5,70.00,I2R(udg_TJzs))
call CreateNUnitsAtLocFacingLocBJ(1,'e00F',GetOwningPlayer(GetTriggerUnit()),udg_TJYDD[2],udg_TJd1)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BHwe',1.50)
call GroupAddUnit(udg_TJdwz,bj_lastCreatedUnit)
call RemoveLocation(udg_TJYDD[2])
set udg_TJ_ZS=udg_TJ_ZS+1
endloop
set udg_TJ_ZS=1
loop
exitwhen udg_TJ_ZS>9
set udg_TJzs=(udg_TJzs+20)
set udg_TJYDD[3]=PolarProjectionBJ(udg_TJd2,200.00,I2R(udg_TJzs))
call CreateNUnitsAtLocFacingLocBJ(1,'e00F',GetOwningPlayer(GetTriggerUnit()),udg_TJYDD[3],udg_TJd1)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BHwe',1.50)
call GroupAddUnit(udg_TJdwz,bj_lastCreatedUnit)
call RemoveLocation(udg_TJYDD[3])
set udg_TJYDD[4]=PolarProjectionBJ(udg_TJd3,200.00,(I2R(udg_TJzs)+180.00))
call CreateNUnitsAtLocFacingLocBJ(1,'e00F',GetOwningPlayer(GetTriggerUnit()),udg_TJYDD[4],udg_TJd1)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BHwe',1.50)
call GroupAddUnit(udg_TJdwz,bj_lastCreatedUnit)
call RemoveLocation(udg_TJYDD[4])
set udg_TJ_ZS=udg_TJ_ZS+1
endloop
call TriggerSleepAction(0.50)
call ForGroupBJ(udg_TJdwz,function Trig_zhunbei_Func012A)
set udg_TJDWZ=GetUnitsInRangeOfLocMatching(500.00,udg_TJd1,Condition(function Trig_zhunbei_Func013002003))
call ForGroupBJ(udg_TJDWZ,function Trig_zhunbei_Func014A)
call DestroyGroup(udg_TJDWZ)
call RemoveLocation(udg_TJd1)
call RemoveLocation(udg_TJd2)
call RemoveLocation(udg_TJd3)
call RemoveLocation(udg_TJd3)
call RemoveLocation(udg_TJd5)
call EnableTrigger(GetTriggeringTrigger())
endfunction
