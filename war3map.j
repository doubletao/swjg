function Trig_SJYXSJ_Actions takes nothing returns nothing
set udg_SJYXTSSX=GetRandomInt(1,4)
if(Trig_SJYXSJ_Func002C())then
call ModifyHeroStat(bj_HEROSTAT_INT,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,1)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffffcc00随机英雄获得额外智力奖励")
else
if(Trig_SJYXSJ_Func002Func001C())then
call ModifyHeroStat(bj_HEROSTAT_AGI,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,1)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffffcc00随机英雄获得额外敏捷奖励")
else
if(Trig_SJYXSJ_Func002Func001Func001C())then
call ModifyHeroStat(bj_HEROSTAT_STR,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,1)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffffcc00随机英雄获得额外力量奖励")
else
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,("|cffffcc00随机英雄获得额外"+(I2S((GetHeroLevel(GetTriggerUnit())*100))+"金钱奖励")))
call AdjustPlayerStateBJ((GetUnitLevel(GetTriggerUnit())*100),GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)
endif
endif
endif
endfunction
