call DestroyTrigger(GetTriggeringTrigger())
call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN,6.00,"ReplaceableTextures\\CameraMasks\\SpecialPowMask.blp",100.00,50.00,50.00,0.00)
call CinematicModeBJ(true,GetPlayersAll())
call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(),Player(10),'E001',"魏延",GetRectCenter(gg_rct________009),null,"谁敢杀我！",bj_TIMETYPE_ADD,0,true)
call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(),Player(8),'Eill',"马岱",GetRectCenter(gg_rct________009),null,"吾敢杀汝！",bj_TIMETYPE_ADD,0,true)
call CinematicModeBJ(false,GetPlayersAll())
call DisplayTextToForce(GetPlayersAll(),"游戏开始选择随机英雄将获得额外属性点奖励,随机送好,赠送可成长玉,经验获得率比选择英雄高出30%")
call TriggerSleepAction(5.00)
call CinematicModeBJ(true,GetPlayersAll())
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nfbr_0131,"大男人",null,"|Cffff0000两分钟后将进入历史游戏模式(千里走单骑，过五关斩。必须要保护好刘备的两个夫人)，趁现在补充一下给养，准备接受挑战！\n你也可以按F9来查看本游戏的详细内容。",bj_TIMETYPE_ADD,0.00,true)
call CinematicModeBJ(false,GetPlayersAll())
call DisplayTimedTextToForce(GetPlayersAll(),30,"|Cffff0000两分钟后将进入历史游戏模式(千里走单骑，过五关斩。必须要保护好刘备的两个夫人)，趁现在补充一下给养，准备接受挑战！\n你也可以按F9来查看本游戏的详细内容。")
call GroupClear(GetUnitsInRectOfPlayer(GetPlayableMapRect(),Player(11)))
call DestroyTrigger(gg_trg_LIYAN)
call TriggerSleepAction(120.00)
call CinematicModeBJ(true,GetPlayersAll())
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nfbr_0131,"大男人",null,"五秒钟后将进入历史游戏模式！\n祝君好运！",bj_TIMETYPE_ADD,2.00,true)
