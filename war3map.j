else
call DoNothing()
endif
else
endif
set udg_I=udg_I+1
endloop
call SetUnitTimeScalePercent(udg_Trigger_the_unit,100.00)
call PauseUnitBJ(false,udg_Trigger_the_unit)
call SetUnitInvulnerable(udg_Trigger_the_unit,false)
