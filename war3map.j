function Trig_GJTM_Func001C takes nothing returns boolean
if((GetOwningPlayer(GetAttackedUnitBJ())==Player(8)))then
return true
endif
if((GetOwningPlayer(GetAttackedUnitBJ())==Player(PLAYER_NEUTRAL_PASSIVE)))then
return true
endif
return false
endfunction
function Trig_GJTM_Conditions takes nothing returns boolean
if(not Trig_GJTM_Func001C())then
return false
endif
if(not(GetOwningPlayer(GetAttacker())!=Player(11)))then
return false
endif
if(not(GetOwningPlayer(GetAttacker())!=Player(10)))then
return false
endif
if(not(GetOwningPlayer(GetAttacker())!=Player(9)))then
return false
endif
if(not(GetOwningPlayer(GetAttacker())!=Player(PLAYER_NEUTRAL_AGGRESSIVE)))then
return false
endif
return true
endfunction
