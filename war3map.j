function Trig_SWCF_Actions takes nothing returns nothing
call SetPlayerStateBJ(GetOwningPlayer(udg_ASWCF_DW),PLAYER_STATE_RESOURCE_GOLD,(GetPlayerState(GetOwningPlayer(udg_ASWCF_DW),PLAYER_STATE_RESOURCE_GOLD)-(GetUnitLevel(udg_ASWCF_DW)*100)))
call DisplayTextToForce(GetPlayersAll(),(GetUnitName(udg_ASWCF_DW)+("受到死亡惩罚，"+("金钱减少"+I2S((GetUnitLevel(udg_ASWCF_DW)*100))))))
if(Trig_SWCF_Func003C())then
call ModifyHeroStat(bj_HEROSTAT_STR,udg_ASWCF_DW,bj_MODIFYMETHOD_SUB,10)
call ModifyHeroStat(bj_HEROSTAT_AGI,udg_ASWCF_DW,bj_MODIFYMETHOD_SUB,10)
call ModifyHeroStat(bj_HEROSTAT_INT,udg_ASWCF_DW,bj_MODIFYMETHOD_SUB,10)
call DisplayTextToForce(GetPlayersAll(),(GetUnitName(udg_ASWCF_DW)+"受到死亡惩罚，全属性减少10点。"))
else
endif
