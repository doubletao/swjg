function Trig_JHYX_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
set udg_JHYX_ZS=1
loop
exitwhen udg_JHYX_ZS>8
if(Trig_JHYX_Func003Func001C())then
set udg_JHYX_TOF[GetConvertedPlayerId(GetTriggerPlayer())]=false
set udg_JHYX_WJ=GetTriggerPlayer()
set udg_JHYX_YX=udg_YINGXIONG[GetConvertedPlayerId(GetTriggerPlayer())]
set udg_JHYX_WJSY=GetConvertedPlayerId(GetTriggerPlayer())
set udg_JHYXPJH_WJ=udg_WANGJIA[udg_JHYX_ZS]
call DialogSetMessage(udg_JHYX_DHK,(GetPlayerName(GetTriggerPlayer())+"请求与你交换英雄"))
call DialogDisplay(udg_JHYXPJH_WJ,udg_JHYX_DHK,true)
call StartTimerBJ(udg_JHYX_JSQ,false,15.00)
call CreateTimerDialogBJ(udg_JHYX_JSQ,"交换英雄")
set udg_JHYX_JSQCK=bj_lastCreatedTimerDialog
call TimerDialogDisplay(udg_JHYX_JSQCK,true)
call DisplayTextToForce(GetPlayersAll(),(GetPlayerName(GetTriggerPlayer())+("希望跟"+(GetPlayerName(udg_JHYXPJH_WJ)+"交换英雄"))))
else
endif
set udg_JHYX_ZS=udg_JHYX_ZS+1
endloop
endfunction
