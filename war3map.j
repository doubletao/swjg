call SetUnitPositionLoc(GetTriggerUnit(),udg_DIANjineng[21])
call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetTriggerUnit()),udg_DIANjineng[22],0)
set udg_JXDW[4]=GetTriggerUnit()
call TriggerSleepAction(5.00)
call CreateNUnitsAtLoc(1,GetUnitTypeId(GetTriggerUnit()),Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_DIANjineng[22],bj_UNIT_FACING)
call SetHeroLevelBJ(GetLastCreatedUnit(),GetUnitLevel(GetTriggerUnit()),false)
call ModifyHeroStat(bj_HEROSTAT_STR,GetLastCreatedUnit(),bj_MODIFYMETHOD_ADD,(GetHeroStr(GetTriggerUnit(),true)*4))
call ModifyHeroStat(bj_HEROSTAT_AGI,GetLastCreatedUnit(),bj_MODIFYMETHOD_ADD,(GetHeroAgi(GetTriggerUnit(),true)*4))
call ModifyHeroStat(bj_HEROSTAT_INT,GetLastCreatedUnit(),bj_MODIFYMETHOD_ADD,(GetHeroInt(GetTriggerUnit(),true)*4))
set udg_JXDW[3]=bj_lastCreatedUnit
call RemoveLocation(udg_DIANjineng[22])
call RemoveLocation(udg_DIANjineng[21])
else
endif
endfunction
