if(not Trig_PK1_Func005C())then
return false
endif
return true
endfunction
function Trig_PK1_Func004Func002C takes nothing returns boolean
if(not(GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)>=(GetUnitLevel(GetTriggerUnit())*1000)))then
return false
endif
return true
endfunction
function Trig_PK1_Func004Func004C takes nothing returns boolean
if((GetKillingUnitBJ()==udg_TYSJY[11]))then
return true
endif
if((GetKillingUnitBJ()==udg_TYSJY[12]))then
return true
endif
return false
endfunction
function Trig_PK1_Func004C takes nothing returns boolean
if(not Trig_PK1_Func004Func004C())then
return false
endif
return true
endfunction
function Trig_PK1_Actions takes nothing returns nothing
call SetPlayerAllianceStateBJ(GetOwningPlayer(udg_TYSJY[11]),GetOwningPlayer(udg_TYSJY[12]),bj_ALLIANCE_ALLIED_VISION)
call SetPlayerAllianceStateBJ(GetOwningPlayer(udg_TYSJY[12]),GetOwningPlayer(udg_TYSJY[11]),bj_ALLIANCE_ALLIED_VISION)
call EnableTrigger(gg_trg_PK)
if(Trig_PK1_Func004C())then
if(Trig_PK1_Func004Func002C())then
call SetPlayerStateBJ(GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_GOLD,(GetPlayerState(GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_GOLD)+(GetHeroLevel(GetTriggerUnit())*1000)))
call SetPlayerStateBJ(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD,(GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)-(GetHeroLevel(GetTriggerUnit())*1000)))
else
call SetPlayerStateBJ(GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_GOLD,(GetPlayerState(GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_GOLD)+GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)))
call SetPlayerStateBJ(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD,0)
endif
call DisplayTextToForce(GetPlayersAll(),"PK结束,胜利者最多将获得失败者等级*1000的金钱")
else
call DisplayTextToForce(GetPlayersAll(),"挑战的一方意外死亡,PK结束(PK系统重新开启)")
endif
endfunction
