function Trig_shengli_______u_Actions takes nothing returns nothing
call RemoveUnit(GetTriggerUnit())
call CinematicModeBJ(true,GetPlayersAll())
call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(),Player(8),'nhef',"甘夫人",GetRectCenter(gg_rct________037),null,"“挂印封金辞汉相，寻兄遥望远途还。马骑赤兔行千里，刀偃青龙出五关。忠义慨然冲宇宙，英雄从此震江山。独行斩将应无敌，今古留题翰墨间。”",bj_TIMETYPE_ADD,0,true)
call CinematicModeBJ(false,GetPlayersAll())
call TriggerSleepAction(5.00)
call GroupClear(GetUnitsInRectOfPlayer(GetPlayableMapRect(),Player(11)))
call CinematicModeBJ(true,GetPlayersAll())
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nfbr_0131,"大男人",null,"恭喜！你们已经战胜了最后的敌人！大家可以将通关录象发布到：http://tstd.uuu9.com   \n祝君好运！",bj_TIMETYPE_ADD,2.00,true)
call CinematicModeBJ(false,GetPlayersAll())
if(Trig_shengli_______u_Func010C())then
call EnableTrigger(gg_trg_JZ_XJN)
call EnableTrigger(gg_trg_JZ_SB)
call EnableTrigger(gg_trg_JZ_BOSSJS)
call TriggerExecute(gg_trg_JHZZ)
call EnableTrigger(gg_trg_X_SL)
call DestroyTrigger(gg_trg_shuabing2)
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nfbr_0131,"大男人",null,"在孟达的里应外合之下,蜀军顺利攻下长安,洛阳,并迫使曹睿逃往许都",bj_TIMETYPE_ADD,0,true)
call StartTimerBJ(udg_JSQ,false,600.00)
call TimerDialogSetTitle(GetLastCreatedTimerDialogBJ(),"追杀剩余时间")
return
else
endif
call TriggerSleepAction(3.00)
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nfbr_0131,"大男人",null,"恭喜你们通关了,要是觉得无聊的话,就自己PK吧",bj_TIMETYPE_ADD,0,true)
call ForForce(GetPlayersAll(),function Trig_shengli_______u_Func013A)
call TriggerExecute(gg_trg_JSPK)
call EnableTrigger(gg_trg_JSPK2)
call EnableTrigger(gg_trg_JSPK3)
call RemoveUnit(gg_unit_h009_0230)
call DestroyTrigger(GetTriggeringTrigger())
endfunction
