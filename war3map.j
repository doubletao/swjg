function Trig_JYZ_HDL_Func001Func001C takes nothing returns boolean
if(not(GetUnitUserData(udg_YINGXIONG[bj_forLoopBIndex])==5))then
return false
endif
return true
endfunction
function Trig_JYZ_HDL_Actions takes nothing returns nothing
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=8
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
if(Trig_JYZ_HDL_Func001Func001C())then
call SetPlayerHandicapXPBJ(GetOwningPlayer(udg_YINGXIONG[bj_forLoopBIndex]),(30.00+(8.00*I2R(GetUnitAbilityLevel(gg_unit_Hpal_0031,'ACev')))))
call DisplayTextToPlayer(GetOwningPlayer(udg_YINGXIONG[bj_forLoopBIndex]),0,0,("当前经验获得率为"+(I2S((30+(8*GetUnitAbilityLevel(gg_unit_Hpal_0031,'ACev'))))+"%")))
else
call SetPlayerHandicapXPBJ(GetOwningPlayer(udg_YINGXIONG[bj_forLoopBIndex]),(15.00+(6.00*I2R(GetUnitAbilityLevel(gg_unit_Hpal_0031,'ACev')))))
call DisplayTextToPlayer(GetOwningPlayer(udg_YINGXIONG[bj_forLoopBIndex]),0,0,("当前经验获得率为"+(I2S((15+(6*GetUnitAbilityLevel(gg_unit_Hpal_0031,'ACev'))))+"%")))
endif
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
call DestroyTrigger(GetTriggeringTrigger())
endfunction
