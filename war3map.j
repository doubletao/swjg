function Trig_TR_Func001Func001C takes nothing returns boolean
if(not(SubString(GetEventPlayerChatString(),4,5)==I2S(bj_forLoopBIndex)))then
return false
endif
return true
endfunction
function Trig_TR_Actions takes nothing returns nothing
set bj_forLoopBIndex=2
set bj_forLoopBIndexEnd=8
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
if(Trig_TR_Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),("主机开始清理垃圾玩家"+I2S(bj_forLoopBIndex)))
call CustomDefeatBJ(udg_WANGJIA[bj_forLoopBIndex],"游戏需要配合,否则不如自己去玩单机")
call SetUnitOwner(udg_YINGXIONG[bj_forLoopBIndex],Player(8),true)
call UnitAddAbilityBJ('A029',udg_YINGXIONG[bj_forLoopBIndex])
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call UnitRemoveItemFromSlotSwapped(bj_forLoopAIndex,udg_YINGXIONG[bj_forLoopBIndex])
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
endif
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
endfunction
