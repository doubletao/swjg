function Trig_SMYi4_Actions takes nothing returns nothing
call DestroyTrigger(GetTriggeringTrigger())
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Ogld_0044,"司马懿",null,"我父子三人皆死于此处矣！",bj_TIMETYPE_ADD,0,true)
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Hant_0005,"孔明",null,"司马懿，你死期到矣！",bj_TIMETYPE_ADD,0,true)
call PolledWait(50.00)
call ForGroupBJ(GetUnitsInRectMatching(gg_rct________040,Condition(function Trig_SMYi4_Func005001002)),function Trig_SMYi4_Func005A)
call ForGroupBJ(GetUnitsInRectMatching(gg_rct________041,Condition(function Trig_SMYi4_Func006001002)),function Trig_SMYi4_Func006A)
call AddWeatherEffectSaveLast(gg_rct________041,'RAhr')
call DisplayTimedTextToForce(GetPlayersAll(),10.00,"忽然狂风大作，黑气漫空，一声霹雳响处，骤雨倾盆。满谷之火尽皆烧灭：地雷不震，火器无功。")
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Ogld_0044,"司马懿",null,"不就此时杀出，更待何时！",bj_TIMETYPE_ADD,0,true)
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Hant_0005,"孔明",null,"谋事在人，成事在天，不可强也...",bj_TIMETYPE_ADD,0,true)
endfunction
