set udg_BLus[(udg_BLP_ZS1+udg_BLn)]=CreateUnit(GetOwningPlayer(udg_BLhero),'h00B',(GetUnitX(udg_BLhero)+((udg_BLdis*I2R(udg_BLP_ZS1))*CosBJ(udg_BLang))),(GetUnitY(udg_BLhero)+((udg_BLdis*I2R(udg_BLP_ZS1))*SinBJ(udg_BLang))),udg_BLang)
