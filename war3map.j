function Trig_LONG_JUAN_Actions takes nothing returns nothing
set udg_i=0
set udg_f=-20.00
set udg_h=0.00
set udg_hero=GetTriggerUnit()
set udg_p0x=GetUnitX(GetTriggerUnit())
set udg_p0y=GetUnitY(GetTriggerUnit())
call SetUnitAnimation(gg_unit_Ogrh_0020,"Spell Slam")
call CreateNUnitsAtLoc(1,'e00D',GetTriggerPlayer(),Location(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit())),bj_UNIT_FACING)
call KillUnit(bj_lastCreatedUnit)
call CreateNUnitsAtLoc(1,'e00E',GetTriggerPlayer(),Location(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit())),bj_UNIT_FACING)
call SetUnitTimeScale(bj_lastCreatedUnit,(0.00-2.27))
call KillUnit(bj_lastCreatedUnit)
call RemoveLocation(Location(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit())))
call TriggerSleepAction(0.10)
set bj_wantDestroyGroup=true
call ForGroupBJ(GetUnitsInRangeOfLocMatching(450.00,Location(udg_p0x,udg_p0y),Condition(function Trig_LONG_JUAN_Func016001003)),function Trig_LONG_JUAN_Func016A)
call StartTimerBJ(udg_t,true,0.03)
endfunction
