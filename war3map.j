function Trig_shengli22222_Actions takes nothing returns nothing
call DestroyTrigger(GetTriggeringTrigger())
call DestroyTrigger(gg_trg_shibai)
call StopMusic(true)
call PlaySoundBJ(gg_snd_IllidansTheme)
call ShowUnit(gg_unit_Hant_0005,false)
call SetUnitInvulnerable(gg_unit_Hpb1_0091,true)
call ShowUnitHide(gg_unit_Hpb1_0091)
call CinematicModeBJ(true,GetPlayersAll())
call SetSkyModel("Environment\\Sky\\LordaeronFallSky\\LordaeronFallSky.mdl")
call ForForce(GetPlayersAll(),function Trig_shengli22222_Func010002)
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nfbr_0131,"大男人",null,"此役之后渭南大寨被蜀兵占领，司马懿烧断浮桥，据住北岸。",bj_TIMETYPE_ADD,0,true)
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_nfbr_0131,"大男人",null,"不久，蜀汉丞相诸葛亮去世，时建兴十二年秋八月二十三日，寿五十四岁。",bj_TIMETYPE_ADD,0,true)
call TriggerSleepAction(3.00)
call ShowUnitShow(gg_unit_E001_0119)
call SetUnitPositionLoc(gg_unit_E001_0119,GetRectCenter(gg_rct________009))
call ShowUnitShow(gg_unit_Emns_0160)
call SetUnitOwner(gg_unit_Emns_0160,Player(8),true)
call PauseAllUnitsBJ(true)
call ForForce(GetPlayersAll(),function Trig_shengli22222_Func019002)
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Hkal_0015,"姜维",null,"反贼魏延！丞相不曾亏你，今日如何背反？",bj_TIMETYPE_ADD,0,true)
call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(),Player(10),'E001',"魏延",GetRectCenter(gg_rct________009),null,"伯约，不干你事。只教杨仪来。",bj_TIMETYPE_ADD,0,true)
call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(),Player(8),'Emns',"杨仪",GetRectCenter(gg_rct________009),null,"丞相在日，知汝久后必反，教我提备，今果应其言。汝敢在马上连叫三声谁敢杀我，便是真大丈夫，吾就献城池与汝。",bj_TIMETYPE_ADD,0,true)
call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(),Player(10),'E001',"魏延",GetRectCenter(gg_rct________009),null,"杨仪匹夫听着，！若孔明在日，吾尚惧他三分；他今已亡，天下谁敢敌我？休道连叫三声，便叫三万声亦有何难？",bj_TIMETYPE_ADD,0,true)
call EnableTrigger(gg_trg_shengli)
call DisplayTimedTextToForce(GetPlayersAll(),5.00,"|Cffff0000杀死魏延，保护好杨仪")
call ForForce(GetPlayersAll(),function Trig_shengli22222_Func026002)
call CinematicModeBJ(false,GetPlayersAll())
call PauseAllUnitsBJ(false)
call IssuePointOrder(gg_unit_Nfir_0233,"attack",-1170.00,-5060.00)
call TriggerSleepAction(30.00)
call ResumeMusic()
endfunction
