function Trig_KSJY_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call SetHeroStr(udg_TYSJY[1],GetHeroStr(udg_TYSJY[0],true),true)
call SetHeroStr(udg_TYSJY[2],GetHeroStr(udg_TYSJY[0],true),true)
call SetHeroAgi(udg_TYSJY[0],GetHeroAgi(udg_TYSJY[1],true),true)
call SetHeroAgi(udg_TYSJY[2],GetHeroAgi(udg_TYSJY[1],true),true)
call SetHeroInt(udg_TYSJY[0],GetHeroInt(udg_TYSJY[2],true),true)
call SetHeroInt(udg_TYSJY[1],GetHeroInt(udg_TYSJY[2],true),true)
call SetHeroLevel(udg_TYSJY[0],(GetUnitLevel(udg_TYSJY[0])+5),true)
call SetHeroLevel(udg_TYSJY[1],(GetUnitLevel(udg_TYSJY[1])+5),true)
call SetHeroLevel(udg_TYSJY[2],(GetUnitLevel(udg_TYSJY[2])+5),true)
call SetUnitUserData(udg_TYSJY[0],6)
call SetUnitUserData(udg_TYSJY[1],6)
call SetUnitUserData(udg_TYSJY[2],6)
call UnitAddAbility(udg_TYSJY[0],'A098')
call UnitMakeAbilityPermanent(udg_TYSJY[0],true,'A098')
call UnitAddAbility(udg_TYSJY[1],'A098')
call UnitMakeAbilityPermanent(udg_TYSJY[1],true,'A098')
call UnitAddAbility(udg_TYSJY[2],'A098')
call UnitMakeAbilityPermanent(udg_TYSJY[2],true,'A098')
call DisplayTextToForce(GetPlayersAll(),("|cFF66CCFF念|cFFFF0000"+(GetUnitName(udg_TYSJY[0])+(GetUnitName(udg_TYSJY[1])+(GetUnitName(udg_TYSJY[2])+("|cFF1FBF00虽然异姓，既结为兄弟，则同心协力，救困扶危；上报国家，下安黎庶。"+"不求同年同月同日生，只愿同年同月同日死。皇天后土，实鉴此心，背义忘恩，天人共戮！"))))))
call DisplayTimedTextToForce(GetPlayersAll(),30,(GetUnitName(udg_TYSJY[0])+(GetUnitName(udg_TYSJY[1])+(GetUnitName(udg_TYSJY[2])+"三人已结为异姓兄弟,所有属性相均衡,并获得经验值50000点.虽不能同生,但必定同死!"))))
set udg_QYD[0]=GetUnitLoc(udg_TYSJY[0])
set udg_QYD[1]=GetUnitLoc(udg_TYSJY[1])
set udg_QYD[2]=GetUnitLoc(udg_TYSJY[2])
