set udg_WP[3]=UnitItemInSlotBJ(udg_YINGXIONG[1],udg_SZ1)
call UnitAddItemSwapped(udg_WP[1],gg_unit_Ntin_0272)
call UnitAddItemSwapped(udg_WP[2],gg_unit_Ntin_0101)
call UnitAddItemSwapped(udg_WP[3],gg_unit_Ntin_0271)
set udg_SZ1=udg_SZ1+1
endloop
set udg_SZ1=1
loop
exitwhen udg_SZ1>6
set udg_WP[1]=UnitItemInSlotBJ(gg_unit_Ntin_0272,udg_SZ1)
call UnitAddItemSwapped(udg_WP[1],udg_YINGXIONG[1])
set udg_SZ1=udg_SZ1+1
endloop
else
endif
endfunction
