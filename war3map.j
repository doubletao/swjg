function Trig_SMSZ_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
set udg_JW=GetSpellTargetUnit()
set udg_KPHWDW=GetUnitLoc(GetSpellTargetUnit())
call SetUnitPathing(GetSpellTargetUnit(),false)
set udg_XHSZS=1
loop
exitwhen udg_XHSZS>6
set udg_KPHWD=PolarProjectionBJ(udg_KPHWDW,160.00,(I2R(udg_XHSZS)*60.00))
call SetDestructableAnimation(CreateDestructableZ('B000',GetLocationX(udg_KPHWD),GetLocationY(udg_KPHWD),GetLocationZ(udg_KPHWD),0.00,1,1),"Birth")
call RemoveLocation(udg_KPHWD)
set udg_XHSZS=udg_XHSZS+1
endloop
call TriggerSleepAction(0.10)
call SetUnitX(udg_JW,GetLocationX(udg_KPHWDW))
call SetUnitY(udg_JW,GetLocationY(udg_KPHWDW))
call SetUnitPathing(udg_JW,true)
if(Trig_SMSZ_Func010C())then
set bj_wantDestroyGroup=true
call ForGroupBJ(GetUnitsInRangeOfLocMatching(500.00,udg_KPHWDW,Condition(function Trig_SMSZ_Func010Func005001003)),function Trig_SMSZ_Func010Func005A)
else
set bj_wantDestroyGroup=true
call ForGroupBJ(GetUnitsInRangeOfLocMatching(500.00,udg_KPHWDW,Condition(function Trig_SMSZ_Func010Func004001003)),function Trig_SMSZ_Func010Func004A)
endif
call TriggerSleepAction(5.00)
call EnumDestructablesInRectAll(GetPlayableMapRect(),function Trig_SMSZ_Func012A)
call RemoveLocation(udg_KPHWDW)
set udg_JW=null
call EnableTrigger(GetTriggeringTrigger())
endfunction
