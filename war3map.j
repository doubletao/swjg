call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Odrt_0028,"马谡",null,"何不急修书，令孟达提防？",bj_TIMETYPE_ADD,0,true)
call QuestMessageBJ(GetPlayersAll(),bj_QUESTMESSAGE_DISCOVERED,"送信")
call CreateItemLoc('mort',GetRectCenter(gg_rct_kai_shi))
call DisplayTextToForce(GetPlayersAll(),"拿着书信去找左上方新城里的孟达。（须穿越魏国营寨）")
call PingMinimapLocForForceEx(GetPlayersAll(),GetUnitLoc(gg_unit_Hpb1_0091),2.00,bj_MINIMAPPINGSTYLE_FLASHY,100,100,100)
call DestroyTrigger(GetTriggeringTrigger())
