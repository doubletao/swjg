function Trig_EASY_Conditions takes nothing returns boolean
if(not(GetClickedButtonBJ()==udg_DHAN))then
return false
endif
return true
endfunction
function Trig_EASY_Func001A takes nothing returns nothing
call AdjustPlayerStateBJ(2500,GetEnumPlayer(),PLAYER_STATE_RESOURCE_GOLD)
endfunction
function Trig_EASY_Actions takes nothing returns nothing
call ForForce(GetPlayersAll(),function Trig_EASY_Func001A)
call RemoveItem(UnitItemInSlotBJ(gg_unit_Ogld_0044,2))
call DisplayTextToForce(GetPlayersAll(),"|cff80FFFF玩家1选择了游戏模式：无名小卒（这是最简单的难度，适合刚入门的新手玩。）\n|cffFFFFFF【本地图修改内容】\n1.运送粮草赠送全部神器\n2.送粮NPC位置改到诸葛亮附近\n3.删除孔明/杨仪/孟达死亡失败逻辑\n4.项羽之魂/刑天之魂刷新时间改为20秒\n5.五虎将奖励:玄武+魔神+1500属性+30万经验\n6.开启隐藏指令\"一个英雄不够用\"\n7.奋勇杀敌属性奖励30→300\n8.送信奖励:属性10→1000,经验3000→30万\n9.送信后孟达移动到诸葛亮附近\n10.诸葛亮/孟达初始换魔神套装\n11.新城军需官移至诸葛亮附近")
call SetPlayerHandicapBJ(Player(9),50.00)
call SetPlayerHandicapBJ(Player(10),50.00)
call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE),50.00)
call UnitAddAbilityBJ('A007',gg_unit_Hant_0005)
call RemoveItem(GetItemOfTypeFromUnitBJ(gg_unit_Ogld_0044,'ledg'))
call PauseAllUnitsBJ(false)
call EnableTrigger(gg_trg_EWZJ)
call EnableTrigger(gg_trg_WOYAO)
call DisableTrigger(gg_trg_NORMAL)
call DisableTrigger(gg_trg_shua)
call DisableTrigger(gg_trg_HARD)
endfunction
function InitTrig_EASY takes nothing returns nothing
set gg_trg_EASY=CreateTrigger()
