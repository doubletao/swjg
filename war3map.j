if(not(GetRandomInt(1,5)==2))then
return false
endif
return true
endfunction
function Trig_suiji_Actions takes nothing returns nothing
set udg_JHYX_TOF[GetConvertedPlayerId(GetTriggerPlayer())]=true
set udg_DIANjineng[15]=GetRectCenter(gg_rct_kai_shi)
set udg_shuijiDWZ=GetUnitsInRectMatching(gg_rct________046,Condition(function Trig_suiji_Func004002002))
set udg_shuiji=GroupPickRandomUnit(udg_shuijiDWZ)
call DestroyGroup(udg_shuijiDWZ)
call SetCameraBoundsToRectForPlayerBJ(GetTriggerPlayer(),GetEntireMapRect())
call PanCameraToTimedLocForPlayer(GetTriggerPlayer(),udg_DIANjineng[15],0)
call SetUnitPositionLoc(udg_shuiji,udg_DIANjineng[15])
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_FOOD_CAP,6)
call SetPlayerName(GetTriggerPlayer(),(GetPlayerName(GetTriggerPlayer())+GetHeroProperName(udg_shuiji)))
call MultiboardSetItemValue(MultiboardGetItem(bj_lastCreatedMultiboard,GetConvertedPlayerId(GetTriggerPlayer()),0),(udg_ZF[GetConvertedPlayerId(GetTriggerPlayer())]+GetPlayerName(GetTriggerPlayer())))
set udg_YINGXIONG[GetConvertedPlayerId(GetTriggerPlayer())]=udg_shuiji
call SetUnitOwner(udg_shuiji,GetTriggerPlayer(),true)
call SetUnitInvulnerable(udg_shuiji,false)
call SelectUnitForPlayerSingle(udg_shuiji,GetTriggerPlayer())
call SetUnitUserData(udg_shuiji,5)
call UnitAddItemByIdSwapped('tbak',udg_shuiji)
call IncUnitAbilityLevelSwapped('ACev',gg_unit_Hpal_0031)
if(Trig_suiji_Func020C())then
call UnitAddItemByIdSwapped(udg_wplx[GetRandomInt(182,184)],udg_shuiji)
else
call UnitAddItemByIdSwapped(udg_wplx[GetRandomInt(180,181)],udg_shuiji)
endif
call DisplayTimedTextToForce(GetPlayersAll(),60.00,(GetPlayerName(GetTriggerPlayer())+("选择了随机英雄,获得了额外2000黄金的补给以及可成长玉.英雄在成长获得经验值比选择英雄高出30%.随机英雄获得"+GetItemName(GetLastCreatedItem()))))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|Cffff0000如果随机到自己不如意的英雄,请不要灰心,每个英雄都是精心设计也是较平衡的,请用心去使用,发挥该英雄的特长,要是能灵活使用每个英雄,你就是成为一个高手了,如果发现BUG欢迎论坛或是QQ群里提出")
call RemoveLocation(udg_DIANjineng[15])
set udg_shuiji=null
call AdjustPlayerStateBJ(2000,GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)
set udg_WANGJIA[GetConvertedPlayerId(GetTriggerPlayer())]=GetTriggerPlayer()
endfunction
