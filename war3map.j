call EnableTrigger(gg_trg_WUHU)
call PolledWait(2)
call DisplayTimedTextToForce(GetPlayersAll(),5.00,"|Cff00ff00百姓们都在谈论看见活神仙的事！")
call PingMinimapLocForForceEx(GetPlayersAll(),GetUnitLoc(gg_unit_ospw_0217),2.00,bj_MINIMAPPINGSTYLE_FLASHY,100,100,100)
