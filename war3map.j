call TriggerRegisterPlayerChatEvent(gg_trg_suiji,Player(4),"-suiji",true)
call TriggerRegisterPlayerChatEvent(gg_trg_suiji,Player(5),"-suiji",true)
call TriggerRegisterPlayerChatEvent(gg_trg_suiji,Player(6),"-suiji",true)
call TriggerRegisterPlayerChatEvent(gg_trg_suiji,Player(7),"-suiji",true)
