function Trig_FUHUO_Actions takes nothing returns nothing
if(Trig_FUHUO_Func001C())then
set udg_ASWCF_DW=GetTriggerUnit()
call TriggerExecute(gg_trg_SWCF)
else
endif
if(Trig_FUHUO_Func002C())then
if(Trig_FUHUO_Func002Func002C())then
set udg_HKE=GetUnitLoc(GetTriggerUnit())
call ReviveHeroLoc(GetTriggerUnit(),udg_HKE,true)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"在结义兄弟的鼓励之下,你又顽强的活了过来")
call RemoveLocation(udg_HKE)
return
else
if(Trig_FUHUO_Func002Func002Func001C())then
call KillUnit(udg_TYSJY[1])
call KillUnit(udg_TYSJY[2])
call DisplayTextToPlayer(GetOwningPlayer(udg_TYSJY[1]),0,0,("不求同生,但求同死.你的结义兄弟"+(GetUnitName(udg_TYSJY[0])+"死亡,大家一起同生死吧")))
call DisplayTextToPlayer(GetOwningPlayer(udg_TYSJY[2]),0,0,("不求同生,但求同死.你的结义兄弟"+(GetUnitName(udg_TYSJY[0])+"死亡,大家一起同生死吧")))
else
if(Trig_FUHUO_Func002Func002Func001Func006C())then
call KillUnit(udg_TYSJY[0])
call KillUnit(udg_TYSJY[2])
call DisplayTextToPlayer(GetOwningPlayer(udg_TYSJY[0]),0,0,("不求同生,但求同死.你的结义兄弟"+(GetUnitName(udg_TYSJY[1])+"死亡,大家一起同生死吧")))
call DisplayTextToPlayer(GetOwningPlayer(udg_TYSJY[2]),0,0,("不求同生,但求同死.你的结义兄弟"+(GetUnitName(udg_TYSJY[1])+"死亡,大家一起同生死吧")))
else
call KillUnit(udg_TYSJY[0])
call KillUnit(udg_TYSJY[1])
call DisplayTextToPlayer(GetOwningPlayer(udg_TYSJY[0]),0,0,("不求同生,但求同死.你的结义兄弟"+(GetUnitName(udg_TYSJY[2])+"死亡,大家一起同生死吧")))
call DisplayTextToPlayer(GetOwningPlayer(udg_TYSJY[1]),0,0,("不求同生,但求同死.你的结义兄弟"+(GetUnitName(udg_TYSJY[2])+"死亡,大家一起同生死吧")))
endif
endif
endif
else
endif
set udg_SZFH=(5.00+I2R(GetUnitLevel(gg_unit_Hpal_0031)))
call DisplayTimedTextToForce(GetPlayersAll(),5.00,(I2S(R2I(udg_SZFH))+"秒后复活，请耐心等待。"))
call PolledWait(udg_SZFH)
call ReviveHeroLoc(GetTriggerUnit(),GetRectCenter(gg_rct________007),true)
endfunction
