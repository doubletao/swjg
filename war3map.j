function Trig_YXJHDHK_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call DialogSetMessage(udg_JHYX_DHK,(GetPlayerName(GetTriggerPlayer())+"请求与你交换英雄"))
set udg_JHYX_AN1=DialogAddButton(udg_JHYX_DHK,"同意",'Y')
set udg_JHYX_AN2=DialogAddButton(udg_JHYX_DHK,"拒绝",'N')
endfunction
function InitTrig_YXJHDHK takes nothing returns nothing
set gg_trg_YXJHDHK=CreateTrigger()
