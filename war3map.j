function Trig_WANGJIAMINGZHI_Actions takes nothing returns nothing
if(Trig_WANGJIAMINGZHI_Func004C())then
call DisplayTextToForce(GetPlayersAll(),"诸葛瞻：孔明之子,战斗型法师。\n可学得：呼风唤雨，血魔盾，真·奇门遁甲，天火\n|Cff00ff00终极技能：五行八卦·奇门遁甲术")
else
if(Trig_WANGJIAMINGZHI_Func004Func001C())then
call DisplayTextToForce(GetPlayersAll(),"黄忠：字汉升，三国时期蜀汉著名将领，五虎将之一。\n可学得：百步穿扬，百发百中，击晕矢，老当益壮\n|Cff00ff00终极技能：万箭穿心")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"黄月英：孔明的妻子，黄承彦的女儿，冰系法师。\n可学得：玄冰咒，玄冰甲，玄冰真气，玄冰爆\n|Cff00ff00终极技能：天降甘霖 ")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"马岱：马超之弟，敏捷型武将。\n可学得：残影剑，勇往直前，会心一击，袖箭\n|Cff00ff00终极技能：西凉骑术")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"马谡：马良之弟，电系法师。\n可学得：落雷，电闪雷鸣，天雷琐，闪电护盾\n|Cff00ff00终极技能：狂雷天牢")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"赵云：字子龙(?～229年) 三国时期蜀汉名将。敏捷型战士。\n可学得：会心一击，龙行天下，镜像，一骑当千\n|Cff00ff00终极技能：浴血奋战")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"张苞：张飞之子，近战力量型武将。\n可学得：地裂脚，野蛮撞击，狮子吼，天下无敌\n|Cff00ff00终极技能：力拔山兮气盖世 ")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"祝融夫人：孟获之妻，远程敏捷英雄。\n可学得：爆裂箭，月刃剑，袖里刃，虎啸\n|Cff00ff00终极技能：飞轮海")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"孟获：南蛮之王，近战力量型武将。\n可学得：尖刺护甲，铜墙铁壁，雷霆飞斧，雷霆一击\n|Cff00ff00终极技能：天生蛮力")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"关兴：关羽的长子，近战敏捷型英雄。\n可学得：横扫千军，会心一击，幻影斩，血刃\n|Cff00ff00终极技能：真实残像")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"关索：关羽之子，近战力量型英雄。\n可学得：春秋刀法，分裂攻击，重锤，八门金锁阵\n|Cff00ff00终极技能：武神")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"夏侯霸：夏侯渊之子，火系力量英雄\n可学得：燃灰，投掷，擒龙手，赤炎护体\n|Cff00ff00终极技能：如来神掌")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"赵广：赵云之子，远程敏捷英雄。\n可学得：霜冻之箭，玄冰神箭，鹤翼阵，镜象。\n|Cff00ff00终极技能：混沌箭阵 ")
else
if(Trig_WANGJIAMINGZHI_Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C())then
call DisplayTextToForce(GetPlayersAll(),"王平：原是魏国武将，因与徐晃不睦而投蜀，辅助型英雄。\n可学得：削铁如泥，群体治疗，鱼鳞阵，战斗模式\n|Cff00ff00终极技能：援军令 ")
