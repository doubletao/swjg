function Trig_TZ_JN_1_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
set udg_TZRR_TOF=true
set udg_TZRR_D1=GetUnitLoc(GetTriggerUnit())
set udg_TZRR_D2=GetSpellTargetLoc()
if(Trig_TZ_JN_1_Func005C())then
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"距离太近")
call SetUnitPosition(GetTriggerUnit(),GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()))
call RemoveLocation(udg_TZRR_D2)
call RemoveLocation(udg_TZRR_D1)
call EnableTrigger(GetTriggeringTrigger())
return
else
set udg_TZRR_DWZ=GetUnitsInRangeOfLocMatching(200.00,udg_TZRR_D1,Condition(function Trig_TZ_JN_1_Func005Func001002003))
if(Trig_TZ_JN_1_Func005Func002C())then
set udg_TZRR_SJDW=GroupPickRandomUnit(udg_TZRR_DWZ)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,("准备扔"+GetUnitName(udg_TZRR_SJDW)))
call UnitAddAbility(udg_TZRR_SJDW,'Amrf')
call UnitRemoveAbility(udg_TZRR_SJDW,'Amrf')
call SetUnitPathing(udg_TZRR_SJDW,false)
call GroupClear(udg_TZRR_DWZ)
call DestroyGroup(udg_TZRR_DWZ)
call EnableTrigger(gg_trg_TZ_JN_2)
else
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"附近没有可以用来丢的单位")
call GroupClear(udg_TZRR_DWZ)
call DestroyGroup(udg_TZRR_DWZ)
call SetUnitPosition(GetTriggerUnit(),GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()))
call RemoveLocation(udg_TZRR_D2)
call RemoveLocation(udg_TZRR_D1)
call EnableTrigger(GetTriggeringTrigger())
endif
endif
endfunction
