function Trig_boss33_Actions takes nothing returns nothing
set udg_DIANshua[0]=GetRectCenter(gg_rct________013)
set udg_DIANshua[4]=GetRandomLocInRect(gg_rct________006)
set udg_DIANshua[6]=GetRectCenter(gg_rct_kai_shi)
call ShowUnitShow(udg_Boss[GetUnitLevel(gg_unit_Hpal_0031)])
if(Trig_boss33_Func006C())then
call SetUnitPositionLoc(udg_Boss[GetUnitLevel(gg_unit_Hpal_0031)],udg_DIANshua[0])
call CreateNUnitsAtLoc(1,udg_guawuYY[GetRandomInt(1,6)],Player(10),udg_DIANshua[0],bj_UNIT_FACING)
call SetHeroLevelBJ(GetLastCreatedUnit(),(GetUnitLevel(gg_unit_Hpal_0031)*6),false)
call UnitAddAbilityBJ(udg_JNsuiji[GetRandomInt(1,19)],GetLastCreatedUnit())
call UnitAddAbilityBJ(udg_JNsuiji[GetRandomInt(1,19)],GetLastCreatedUnit())
call IssueTargetOrder(GetLastCreatedUnit(),"attack",gg_unit_Hant_0005)
else
call SetUnitPositionLoc(udg_Boss[GetUnitLevel(gg_unit_Hpal_0031)],udg_DIANshua[4])
call CreateNUnitsAtLoc(1,udg_guawuYY[GetRandomInt(1,6)],Player(10),udg_DIANshua[4],bj_UNIT_FACING)
call SetHeroLevelBJ(GetLastCreatedUnit(),(GetUnitLevel(gg_unit_Hpal_0031)*6),false)
call UnitAddAbilityBJ(udg_JNsuiji[GetRandomInt(1,17)],GetLastCreatedUnit())
call UnitAddAbilityBJ(udg_JNsuiji[GetRandomInt(1,17)],GetLastCreatedUnit())
call IssueTargetOrder(GetLastCreatedUnit(),"attack",gg_unit_Hant_0005)
endif
call DisplayTimedTextToForce(GetPlayersAll(),6.00,(("敌主将："+GetUnitName(udg_Boss[GetUnitLevel(gg_unit_Hpal_0031)]))+"已经出现，请小心应付！"))
call IssuePointOrderLoc(udg_Boss[GetUnitLevel(gg_unit_Hpal_0031)],"attack",udg_DIANshua[6])
call DisableTrigger(gg_trg_laobaix)
call CreateNUnitsAtLoc(1,'nder',Player(PLAYER_NEUTRAL_PASSIVE),udg_DIANshua[4],bj_UNIT_FACING)
set udg_DW123=GetLastCreatedUnit()
call UnitApplyTimedLifeBJ(150.00,'BEfn',udg_DW123)
call RemoveLocation(udg_DIANshua[0])
call RemoveLocation(udg_DIANshua[4])
call RemoveLocation(udg_DIANshua[6])
call DisableTrigger(gg_trg_shuabing)
call DisableTrigger(gg_trg_shuaBOSS)
call DisableTrigger(gg_trg_shuaBOSS_______u)
call DisableTrigger(gg_trg_yaohuen)
call DisableTrigger(gg_trg_shuabingXC2)
endfunction
